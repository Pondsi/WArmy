{
  "name": "@warmy/memory-os",
  "version": "0.1.0",
  "private": true,
  "description": "L2 记忆服务：JSONL 只追加 + SQLite FTS 投影（长驻子进程）",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ipc": {
      "import": "./dist/ipc.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty",
    "start": "node dist/ipc.js",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@warmy/contracts": "workspace:*",
    "better-sqlite3": "13.0.3",
    "onnxruntime-web": "1.22.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.9.0"
  }
}
