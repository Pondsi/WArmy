{
  "version": 1,
  "servers": {
    "echo": {
      "command": "node",
      "args": ["./echo-server.mjs"],
      "cwd": ".",
      "env": {},
      "timeoutMs": 15000,
      "enabled": false,
      "description": "Built-in demo MCP server shipped with this plugin. Flip enabled to true to see tools appear."
    },
    "agent-desktop": {
      "command": "agent-desktop",
      "args": ["--mcp"],
      "cwd": ".",
      "env": {},
      "timeoutMs": 20000,
      "enabled": false,
      "description": "R300 external Computer Use, disabled by default. Install a compatible stdio MCP server and map its real tool names. WArmy exposes six logical capabilities only; shell, file and process management are not exposed.",
      "computerUse": {
        "windowTtlMs": 60000,
        "toolMap": {
          "list_windows": "list_windows",
          "screenshot": "screenshot",
          "click": "click",
          "type_text": "type_text",
          "drag": "drag",
          "scroll": "scroll"
        }
      }
    }
  }
}
