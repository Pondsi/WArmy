{
  "name": "@warmy/app-shell",
  "version": "0.2.31",
  "private": true,
  "description": "Electron main/renderer shell (no native modules)",
  "main": "./dist/electron-main.js",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b && node scripts/check-syntax.mjs && node scripts/copy-assets.mjs",
    "typecheck": "tsc -b --pretty",
    "start": "electron dist/electron-main.js",
    "dist": "electron-builder --config electron-builder.yml",
    "clean": "rimraf dist *.tsbuildinfo",
    "dev": "node scripts/dev-restart.mjs"
  },
  "dependencies": {
    "@warmy/asset-governance": "workspace:*",
    "@warmy/board": "workspace:*",
    "@warmy/ccr-compressor": "workspace:*",
    "@warmy/contracts": "workspace:*",
    "@warmy/dsh-runtime": "workspace:*",
    "@warmy/group-router": "workspace:*",
    "@warmy/knowledge-base": "workspace:*",
    "@warmy/memory-os": "workspace:*",
    "@warmy/providers": "workspace:*",
    "@warmy/sync-protocol": "workspace:*"
  },
  "optionalDependencies": {
    "sherpa-onnx-node": "1.13.8"
  },
  "devDependencies": {
    "@types/node": "24.9.0",
    "electron": "45.1.0",
    "electron-builder": "25.1.8"
  },
  "types": "./dist/index.d.ts",
  "author": "Pondsi",
  "license": "SEE LICENSE IN LICENSE"
}
