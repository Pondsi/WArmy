{
  "name": "@ccarmy/app-shell",
  "version": "0.1.0",
  "private": true,
  "description": "Electron主/渲染进程壳（零原生模块）",
  "type": "module",
  "main": "./dist/electron-main.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b && node scripts/copy-assets.mjs",
    "typecheck": "tsc -b --pretty",
    "start": "electron dist/electron-main.js",
    "dist": "electron-builder --config electron-builder.yml",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@ccarmy/contracts": "workspace:*",
    "@ccarmy/dsh-runtime": "workspace:*",
    "@ccarmy/memory-os": "workspace:*",
    "@ccarmy/providers": "workspace:*",
    "@ccarmy/group-router": "workspace:*",
    "@ccarmy/board": "workspace:*",
    "@ccarmy/ccr-compressor": "workspace:*",
    "@ccarmy/knowledge-base": "workspace:*",
    "@ccarmy/sync-protocol": "workspace:*",
    "@ccarmy/asset-governance": "workspace:*"
  },
  "devDependencies": {
    "electron": "33.2.0",
    "electron-builder": "25.1.8"
  }
}
