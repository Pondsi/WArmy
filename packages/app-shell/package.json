{
  "name": "@warmy/app-shell",
  "version": "0.4.68",
  "private": true,
  "description": "Electron main/renderer shell (no native modules)",
  "main": "./dist/electron-main.js",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b && node scripts/build-mimic-three.mjs && node scripts/check-syntax.mjs && node scripts/copy-assets.mjs",
    "typecheck": "tsc -b --pretty",
    "start": "electron dist/electron-main.js",
    "dist": "electron-builder --config electron-builder.yml",
    "clean": "rimraf dist *.tsbuildinfo",
    "dev": "node scripts/dev-restart.mjs"
  },
  "dependencies": {
    "@a2ui/agent": "0.2.1",
    "@a2ui/lit": "0.16.0",
    "@a2ui/web_core": "0.16.1",
    "@duckdb/node-api": "2.0.0-r.1",
    "@pixiv/three-vrm": "3.5.5",
    "@warmy/asset-governance": "workspace:*",
    "@warmy/board": "workspace:*",
    "@warmy/ccr-compressor": "workspace:*",
    "@warmy/contracts": "workspace:*",
    "@warmy/dsh-runtime": "workspace:*",
    "@warmy/group-router": "workspace:*",
    "@warmy/knowledge-base": "workspace:*",
    "@warmy/memory-os": "workspace:*",
    "@warmy/providers": "workspace:*",
    "@warmy/sync-protocol": "workspace:*",
    "diwen": "https://registry.npmjs.org/diwen/-/diwen-6.16.4.tgz",
    "franc-all": "7.2.0",
    "hash-wasm": "4.12.0",
    "pinyin-pro": "3.29.5",
    "three": "0.187.0"
  },
  "optionalDependencies": {
    "sherpa-onnx-node": "1.13.8"
  },
  "devDependencies": {
    "@types/node": "24.9.0",
    "electron": "45.1.0",
    "electron-builder": "25.1.8",
    "esbuild": "0.25.12"
  },
  "types": "./dist/index.d.ts",
  "author": "Pondsi",
  "license": "SEE LICENSE IN LICENSE"
}

